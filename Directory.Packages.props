<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- AngleSharp is a first-class dependency of the test project, not a
         transitive leak: the tests compile against AngleSharp.Dom types that
         bunit surfaces from its rendered DOM. A compile-time dependency
         supplied only transitively is a latent break — bunit could retarget
         its DOM layer and the tests would stop compiling — so it is declared
         here and promoted to a direct PackageReference in the test csproj. A
         dependency audit must keep it. -->
    <PackageVersion Include="AngleSharp" Version="1.6.0" />
    <PackageVersion Include="bunit" Version="2.8.6" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.61.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
