@page "/quiz"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using BgDataTypes_Lib
@using BackgammonDiagram_Lib
@using BgDiag_Razor.Components
@using BgQuiz_Blazor.Client.Quiz

@inject QuizController Controller
@inject QuizStatsStore StatsStore
@inject QuizNoticeDismissal Notices
@inject QuizSettings Settings
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>BgQuiz — In progress</PageTitle>

@* app-busy: progress cursor while a Continue/Skip transition runs (app.css);
   the controller's gate yield lets it paint before the advance's churn. *@
<div class="container-fluid py-3 board-page @(Controller.IsBusy ? "app-busy" : null)">
    @* Active-context stats notices: scoped to the running quiz's stats context
       (bound at Start, reset by the next Start's re-bind). A load failure is an
       outcome — the quiz runs, the file stays untouched — so polite
       role="status"; a write failure is a failure mid-quiz, so the assertive
       alert idiom. Neither ever blocks the quiz.

       Dismissible, like every notice on this page (see DismissStats): keyed on
       the store's StatusOccurrence, so a dismissal covers the report the user
       actually read — a later Ready → WriteFailed, or the next run binding
       against the same unreadable file, is a new occurrence and shows again. *@
    @* The stats-retirement report: this run found a stats file in the retired
       format, set it aside, and started a fresh one. An outcome and not a
       failure — the quiz records normally into the new file — so the polite
       informational idiom, beside (not instead of) whatever the degrade notice
       below is saying. Its own occurrence token, so dismissing it and
       dismissing a later write failure are two separate gestures. *@
    @if (StatsStore.StatsRetiredOccurrence is { } retired
         && !Notices.IsDismissed(QuizNotice.StatsRetired, retired))
    {
        <div class="alert alert-info alert-dismissible quiz-notice" role="status"
             @onclick="DismissStatsRetired">
            Your stats file was written by an earlier version of BgQuiz and can't be
            carried forward. It has been set aside as
            <strong>@retired.SetAsideFileName</strong> and a new
            <strong>@QuizStatsFile.FileName</strong> started, so your lifetime stats
            begin again with this quiz.
            <button type="button" class="btn-close" aria-label="Dismiss this message"
                    @onclick="DismissStatsRetired" @onclick:stopPropagation="true"></button>
        </div>
    }
    @if (!Notices.IsDismissed(QuizNotice.StatsContext, StatsStore.StatusOccurrence))
    {
        @if (StatsStore.Status == QuizStatsStatus.LoadFailed)
        {
            <div class="alert alert-warning alert-dismissible quiz-notice" role="status"
                 @onclick="DismissStats">
                The existing <strong>@QuizStatsFile.FileName</strong> couldn't be read, so this
                quiz won't record stats. The file has not been changed.
                <button type="button" class="btn-close" aria-label="Dismiss this message"
                        @onclick="DismissStats" @onclick:stopPropagation="true"></button>
            </div>
        }
        else if (StatsStore.Status == QuizStatsStatus.WriteFailed)
        {
            <div class="alert alert-danger alert-dismissible quiz-notice" role="alert"
                 @onclick="DismissStats">
                Your stats file could not be saved — the quiz continues, but this
                quiz's stats won't be recorded.
                <button type="button" class="btn-close" aria-label="Dismiss this message"
                        @onclick="DismissStats" @onclick:stopPropagation="true"></button>
            </div>
        }
    }
    @* Mix notices, composition-first: whatever the framing, the first line is
       the quiz actually underway ("Your quiz has N problems: …"), rendered
       from every entry's actual draw. A capless mix gets a polite,
       composition-only status line — without a requested QuizLength the
       percentages bind to nothing, so an entry outdrawn by largest-remainder
       apportionment is composition noise, not a shortfall, and "requested"
       framing would misreport it (the producer guarantees Drawn == Target
       capless: the quiz is the whole deduped union). A length-bound mix keeps
       the honest shortfall alert (assertive — the quiz underway differs from
       what was asked), leading with the composition and demoting the
       per-entry apportionment internals to the explanation below it.

       Both variants retire on the user's first submitted answer OR on a click:
       the notice says how this quiz was built, which is worth reading before
       answering and is stale chrome above the board for every problem after.
       Either gesture ends it — the first-answer retirement is unchanged by the
       click affordance, and a user who has read it early gets the space back
       early. The dismissal lives in QuizNoticeDismissal — a holder, not a page
       field, so the Show-stats round trip can't resurrect it — keyed on this
       composition's identity so the next run's notice shows again. The
       controller's telemetry is deliberately left intact: it still frames this
       notice, counts the quiz's problems, and feeds Home's composed-to-zero
       wording. *@
    @if (Controller.LastComposition is { } comp
         && !Notices.IsDismissed(QuizNotice.Composition, comp))
    {
        @if (!Controller.ActiveMixHasLength)
        {
            <div class="alert alert-info alert-dismissible quiz-notice" role="status"
                 @onclick="@(() => DismissComposition(comp))">
                @MixDisplay.CompositionSummary(comp)
                <button type="button" class="btn-close" aria-label="Dismiss this message"
                        @onclick="@(() => DismissComposition(comp))"
                        @onclick:stopPropagation="true"></button>
            </div>
        }
        else if (HasShortfall(comp))
        {
            <div class="alert alert-warning alert-dismissible quiz-notice" role="alert"
                 @onclick="@(() => DismissComposition(comp))">
                <button type="button" class="btn-close" aria-label="Dismiss this message"
                        @onclick="@(() => DismissComposition(comp))"
                        @onclick:stopPropagation="true"></button>
                <div>@MixDisplay.CompositionSummary(comp)</div>
                @if (comp.DrawnCount < comp.TargetCount)
                {
                    <div>
                        Your mix asked for @comp.TargetCount problems but only
                        @comp.DrawnCount could be drawn — these categories ran short:
                    </div>
                    <ul class="mb-0">
                        @foreach (var entry in comp.Entries.Where(e => e.Drawn < e.Requested))
                        {
                            <li>@MixDisplay.CategoryLabel(entry.Category): drew @entry.Drawn of @entry.Requested requested</li>
                        }
                    </ul>
                }
                else
                {
                    <div>
                        Some categories couldn't fill their share; the difference
                        went to the others:
                    </div>
                    <ul class="mb-0">
                        @foreach (var entry in comp.Entries.Where(e => e.Drawn < e.Requested))
                        {
                            <li>@MixDisplay.CategoryLabel(entry.Category): filled @entry.Drawn of its @entry.Percent% share (@entry.Requested requested)</li>
                        }
                    </ul>
                }
            </div>
        }
    }
    @if (!Controller.HasStarted)
    {
        <div class="alert alert-warning" role="alert">
            No quiz in progress. <a href="/">Pick filters and start a quiz.</a>
        </div>
    }
    else if (Controller.Current is { } current)
    {
        // Captured once: both the board branch and the chrome branch key off
        // review, and two separate `is { } review` patterns would collide in
        // the single generated render method's scope.
        var review = Controller.Review;

        @* Board on top; the chrome (score panel, legend, verdict, actions) sits
           in the full-width region below it. The board sizes width-first from
           this row and takes its height from the producer's own aspect-ratio —
           BgQuiz names no ratio anywhere.

           Nothing is overlaid on the canvas here: the XGID left the producer's
           Overlay slot for the bottom row (SPEC-quiz-view.md §4's one-home
           ruling, issue halheinrich/backgammon#98), so all three branches render
           the producer component bare. Adding an overlay back to one branch is
           how the badge would start teleporting between modes again. *@
        <div class="board-container my-3">
            @if (review is not null)
            {
                <BackgammonDiagram Request="BuildSolutionRequest(current, review)"
                                   Options="BoardOptions"
                                   OnDiceClicked="ContinueAsync" />
            }
            else if (current.Decision.IsCube)
            {
                @* Cube answering: the board region is board-only. The cube answer
                   is entered by the BackgammonCubeActions radios in the action row
                   below — not on the board — so this is the same read-only shape as
                   the review branch (a bare BackgammonDiagram in Problem mode). That
                   parity is the arc's whole point: within a view mode the board sizes
                   identically across cube-answering, play-answering, and review. The
                   maximize mode reverses that deliberately and only across the mode
                   boundary — see BoardOptions and SPEC-quiz-view.md §2. *@
                <BackgammonDiagram Request="BuildRenderRequest(current)"
                                   Options="BoardOptions" />
            }
            else
            {
                <BackgammonPlayEntry @ref="_playEntry"
                                     Request="BuildRenderRequest(current)"
                                     Options="BoardOptions"
                                     OnPlayCompleted="HandlePlayCompleted"
                                     OnSubmitRequested="Submit" />
            }
        </div>

        <div class="board-chrome">
            @* Mode-invariant status strip: present in every composition EXCEPT
               maximized answering, at a fixed height, so the chrome's total
               height — and therefore the board's flex remainder, and therefore
               the board size — is identical across the answering and review
               states and across questions *within a view mode*. While answering
               it carries a neutral prompt (legend line empty); at review the
               legend line and the verdict band fill in. Content changes; the box
               never does (long content clamps inside the fixed lines — see
               app.css).

               Suppressed under MaximizedAnswering along with the score panel
               below: SPEC-quiz-view.md §4's chrome-suppression leg. The user
               accepted losing the neutral prompt (and the progress indicator)
               for the answering half of each problem — review restores both,
               every problem. *@
            @if (!MaximizedAnswering)
            {
                <div class="status-strip">
                    <div class="status-legend text-muted small">
                        @(review is not null ? SolutionLegend(review, current.Decision) : null)
                    </div>
                    <div class="status-verdict alert @StatusVerdictColor(review)" role="status">
                        <span class="status-verdict-text">@StatusText(review, current.Decision)</span>
                    </div>
                </div>
            }

            @* ONE action row for every state (.action-row), not one per state.
               Only the leading segment — the answer instruments — branches; the
               trailing cluster (.action-row-tail) is shared, because it is the
               same three things in every state and a second copy of it is how
               two rows drift apart. The semantic class names the region for
               readers and pins alike; the Bootstrap utilities beside them still
               do the layout, as everywhere else on this page.

               One row also means the XGID has one render site (below), which is
               the point of §4's one-home ruling: three sites is exactly how a
               badge ends up rendering differently in one composition.

               Transition-driving buttons disable while the controller is busy
               (the gate would no-op them anyway — this is the honest mirror);
               Show stats stays enabled: it only navigates.

               "End quiz" (issue #57) closes the trailing cluster, after Show
               stats — the far end of the row, as far from the buttons a user
               clicks over and over (Submit, Continue) as the row allows. That
               distance is the whole mitigation: the control is one-click and
               acts immediately, ruled so deliberately, so there is no
               confirmation step to catch a misclick. It is styled like its
               neighbours rather than as a danger action, because ending a run
               early is a normal way to finish one, not a destructive act — Done
               receives it as the completed quiz it is.

               It IS a transition (it retires the enumerator and finishes the
               run), so unlike Show stats it disables on IsBusy. The shared row
               is also what keeps the states' row heights equal by construction —
               what the board's flex remainder depends on, see the status strip's
               fixed-height contract. *@
            <div class="action-row d-flex flex-wrap gap-2 align-items-center">
                @if (review is not null)
                {
                    <button class="btn btn-primary" disabled="@Controller.IsBusy"
                            @onclick="ContinueAsync">
                        Continue
                    </button>
                    <button class="btn btn-outline-secondary" disabled="@Controller.IsBusy"
                            @onclick="RedoAsync">
                        Redo
                    </button>
                }
                else if (current.Decision.IsCube)
                {
                    @* The cube answer lives here in the chrome, beside its own
                       Submit / Skip — the board region above is board-only. The
                       radios lead the row (form order: choose, then Submit lights
                       up); @bind-Value keeps _completedCube current, which gates
                       Submit. There is no automatic reset — HandleStateChanged
                       nulls _completedCube on every advance, clearing the radios. *@
                    <BackgammonCubeActions @bind-Value="_completedCube" />
                    <button class="btn btn-primary"
                            disabled="@(_completedCube is null || Controller.IsBusy)"
                            @onclick="Submit">
                        Submit
                    </button>
                    <button class="btn btn-outline-secondary" disabled="@Controller.IsBusy"
                            @onclick="SkipAsync">
                        Skip
                    </button>
                }
                else
                {
                    <button class="btn btn-primary"
                            disabled="@(_completedPlay is null || Controller.IsBusy)"
                            @onclick="Submit">
                        Submit
                    </button>
                    <button class="btn btn-outline-secondary" disabled="@Controller.IsBusy"
                            @onclick="SkipAsync">
                        Skip
                    </button>
                    @* Busy-only, deliberately not "_playEntry is not null":
                       that @ref is assigned *after* the render that creates
                       the entry, so this branch's first render always read
                       null and disabled both buttons — and nothing
                       re-renders this page during click-by-click assembly,
                       so they stayed disabled until the play completed. The
                       branch already guarantees an entry is rendered
                       (!IsCube), and a click can only land after the ref is
                       assigned, so the null term tested nothing this branch
                       had not already established. See UndoLast. *@
                    <button class="btn btn-outline-secondary"
                            disabled="@Controller.IsBusy"
                            @onclick="UndoLast">
                        Undo last
                    </button>
                    <button class="btn btn-outline-secondary"
                            disabled="@Controller.IsBusy"
                            @onclick="UndoAll">
                        Undo all
                    </button>
                }

                @* The trailing cluster, pushed away from the answer controls by
                   its own ms-auto rather than by the first button's — so the
                   cluster stays right-aligned in the one state that renders no
                   badge at all (a decision with no XGID: XgidLabel renders
                   nothing, and an ms-auto living on the button would then be
                   the wrong element's).

                   THE XGID'S ONE HOME (SPEC-quiz-view.md §4, issue
                   halheinrich/backgammon#98). It leads the cluster — present in
                   both view modes and both states, since maximized answering
                   keeps this row — so it never obscures canvas content and never
                   teleports between modes. It leads rather than closes the
                   cluster so that End quiz keeps the far end of the row, which
                   is #57's mitigation and not this badge's to spend. *@
                <div class="action-row-tail d-flex flex-wrap gap-2 align-items-center ms-auto">
                    <XgidLabel Xgid="@current.Xgid" />
                    <button class="btn btn-outline-secondary" @onclick="ShowStats">
                        Show stats
                    </button>
                    <button class="btn btn-outline-secondary" disabled="@Controller.IsBusy"
                            @onclick="EndQuizAsync">
                        End quiz
                    </button>
                </div>
            </div>

            @* The ongoing-stats strip, at the BOTTOM of the page — below the
               action row, not above the status strip where it used to sit
               (SPEC-quiz-view.md §5). It is reference material read between
               problems, not while deciding one, so it belongs below the controls
               the user is actually reaching for; and the board wants the space
               nearest itself given to the chrome that speaks to the problem in
               hand (the strip's verdict and prompt).

               Reordering inside the chrome block does not change the block's
               total measured height, so the board's flex remainder — and
               therefore board size — is untouched by the move. That is what lets
               this ride alongside the maximize mode without the two interacting.

               Done and Stats render their own ScorePanel with their own
               parameters and are deliberately untouched: one component, one
               move.

               Suppressed under MaximizedAnswering with the status strip above —
               which is also where the "Problem N of M" counter goes, the
               progress indicator §4 ratifies losing for the answering half of
               each problem. *@
            @if (!MaximizedAnswering)
            {
                <ScorePanel Score="Controller.Score"
                            Skipped="Controller.SkippedCount"
                            Source="@Controller.Name"
                            ProblemNumber="Controller.ProblemNumber"
                            ProblemCount="Controller.ProblemCount" />
            }
        </div>
    }
</div>
