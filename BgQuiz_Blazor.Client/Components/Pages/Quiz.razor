@page "/quiz"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using BgDataTypes_Lib
@using BackgammonDiagram_Lib
@using BgDiag_Razor.Components
@using BgQuiz_Blazor.Client.Quiz

@inject QuizController Controller
@inject QuizStatsStore StatsStore
@inject QuizNoticeDismissal Notices
@inject QuizSettings Settings
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>BgQuiz — In progress</PageTitle>

@* app-busy: progress cursor while a transition runs — a draw for ▶, or a
   Submit's write to the lifetime record (app.css); the controller's gate yield
   lets it paint before an advance's churn. *@
<div class="container-fluid py-3 board-page @(Controller.IsBusy ? "app-busy" : null)">
    @* Active-context stats notices: scoped to the running quiz's stats context
       (bound at Start, reset by the next Start's re-bind). A load failure is an
       outcome — the quiz runs, the file stays untouched — so polite; a write
       failure is a failure mid-quiz, so assertive. Neither ever blocks the quiz.

       Dismissible, like every notice on this page, and held by the owner of
       the occurrence (SPEC-notices.md §2): QuizNoticeDismissal, keyed on the
       store's StatusOccurrence, so a dismissal covers the report the user
       actually read — a later Ready → WriteFailed, or the next run binding
       against the same unreadable file, is a new occurrence and shows again.
       Done renders the same notices bound to the same slot and occurrence, so
       one dismissed here stays dismissed there. *@
    @* The stats-retirement report: this run found a stats file in the retired
       format, set it aside, and started a fresh one. An outcome and not a
       failure — the quiz records normally into the new file — so polite and
       informational, beside (not instead of) whatever the degrade notice below
       is saying. Its own slot and occurrence token, so dismissing it and
       dismissing a later write failure are two separate gestures. *@
    @if (StatsStore.StatsRetiredOccurrence is { } retired)
    {
        <Notice Kind="NoticeKind.Information" Announcement="NoticeAnnouncement.Polite"
                Dismissible="true"
                @bind-Dismissed:get="Notices.IsDismissed(QuizNotice.StatsRetired, retired)"
                @bind-Dismissed:set="_ => Notices.Dismiss(QuizNotice.StatsRetired, retired)">
            Your stats file was written by an earlier version of BgQuiz and can't be
            carried forward. It has been set aside as
            <strong>@retired.SetAsideFileName</strong> and a new
            <strong>@QuizStatsFile.FileName</strong> started, so your lifetime stats
            begin again with this quiz.
        </Notice>
    }
    @if (StatsStore.Status == QuizStatsStatus.LoadFailed)
    {
        <Notice Kind="NoticeKind.Warning" Announcement="NoticeAnnouncement.Polite"
                Dismissible="true"
                @bind-Dismissed:get="Notices.IsDismissed(QuizNotice.StatsContext, StatsStore.StatusOccurrence)"
                @bind-Dismissed:set="_ => Notices.Dismiss(QuizNotice.StatsContext, StatsStore.StatusOccurrence)">
            The existing <strong>@QuizStatsFile.FileName</strong> couldn't be read, so this
            quiz won't record stats. The file has not been changed.
        </Notice>
    }
    else if (StatsStore.Status == QuizStatsStatus.WriteFailed)
    {
        <Notice Kind="NoticeKind.Error" Announcement="NoticeAnnouncement.Assertive"
                Dismissible="true"
                @bind-Dismissed:get="Notices.IsDismissed(QuizNotice.StatsContext, StatsStore.StatusOccurrence)"
                @bind-Dismissed:set="_ => Notices.Dismiss(QuizNotice.StatsContext, StatsStore.StatusOccurrence)">
            Your stats file could not be saved — the quiz continues, but this
            quiz's stats won't be recorded.
        </Notice>
    }
    @* Mix notices, composition-first: whatever the framing, the first line is
       the quiz actually underway ("Your quiz has N problems: …"), rendered
       from every entry's actual draw. A capless mix gets a polite,
       composition-only status line — without a requested QuizLength the
       percentages bind to nothing, so an entry outdrawn by largest-remainder
       apportionment is composition noise, not a shortfall, and "requested"
       framing would misreport it (the producer guarantees Drawn == Target
       capless: the quiz is the whole deduped union). A length-bound mix keeps
       the honest shortfall alert (assertive — the quiz underway differs from
       what was asked), leading with the composition and demoting the
       per-entry apportionment internals to the explanation below it.

       Both variants retire on the user's first submitted answer OR on a click:
       the notice says how this quiz was built, which is worth reading before
       answering and is stale chrome above the board for every problem after.
       Either gesture ends it — the first-answer retirement is unchanged by the
       click affordance, and a user who has read it early gets the space back
       early. The dismissal lives in QuizNoticeDismissal — a holder, not a page
       field, so the Show-stats round trip can't resurrect it — keyed on this
       composition's identity so the next run's notice shows again. The
       controller's telemetry is deliberately left intact: it still frames this
       notice, counts the quiz's problems, and feeds Home's composed-to-zero
       wording. *@
    @if (Controller.LastComposition is { } comp)
    {
        @if (!comp.HasRequestedLength)
        {
            <Notice Kind="NoticeKind.Information" Announcement="NoticeAnnouncement.Polite"
                    Dismissible="true"
                    @bind-Dismissed:get="Notices.IsDismissed(QuizNotice.Composition, comp)"
                    @bind-Dismissed:set="_ => DismissComposition(comp)">
                @MixDisplay.CompositionSummary(comp)
            </Notice>
        }
        else if (HasShortfall(comp))
        {
            <Notice Kind="NoticeKind.Warning" Announcement="NoticeAnnouncement.Assertive"
                    Dismissible="true"
                    @bind-Dismissed:get="Notices.IsDismissed(QuizNotice.Composition, comp)"
                    @bind-Dismissed:set="_ => DismissComposition(comp)">
                <div>@MixDisplay.CompositionSummary(comp)</div>
                @if (comp.DrawnCount < comp.TargetCount)
                {
                    <div>
                        Your mix asked for @comp.TargetCount problems but only
                        @comp.DrawnCount could be drawn — these categories ran short:
                    </div>
                    <ul class="mb-0">
                        @foreach (var entry in comp.Entries.Where(e => e.Drawn < e.Requested))
                        {
                            <li>@MixDisplay.CategoryLabel(entry.Category): drew @entry.Drawn of @entry.Requested requested</li>
                        }
                    </ul>
                }
                else
                {
                    <div>
                        Some categories couldn't fill their share; the difference
                        went to the others:
                    </div>
                    <ul class="mb-0">
                        @foreach (var entry in comp.Entries.Where(e => e.Drawn < e.Requested))
                        {
                            <li>@MixDisplay.CategoryLabel(entry.Category): filled @entry.Drawn of its @entry.Percent% share (@entry.Requested requested)</li>
                        }
                    </ul>
                }
            </Notice>
        }
    }
    @* The page's whole content in this state, so a gate reason and not
       dismissible (SPEC-notices.md Fork C): closed, it would leave an empty
       page that cannot say why. *@
    @if (!Controller.HasStarted)
    {
        <Notice Kind="NoticeKind.Warning" Announcement="NoticeAnnouncement.Assertive">
            No quiz in progress. <a href="/">Pick filters and start a quiz.</a>
        </Notice>
    }
    else if (Controller.Current is { } current)
    {
        // Captured once: both the board branch and the chrome branch key off
        // review, and two separate `is { } review` patterns would collide in
        // the single generated render method's scope.
        var review = Controller.Review;

        @* Board on top; the chrome (score panel, legend, verdict, actions) sits
           in the full-width region below it. The board sizes width-first from
           this row and takes its height from the producer's own aspect-ratio —
           BgQuiz names no ratio anywhere.

           Nothing is overlaid on the canvas here: the XGID left the producer's
           Overlay slot for the bottom row (SPEC-quiz-view.md §4's one-home
           ruling, issue halheinrich/backgammon#98), so all three branches render
           the producer component bare. Adding an overlay back to one branch is
           how the badge would start teleporting between modes again. *@
        <div class="board-container my-3">
            @if (review is not null)
            {
                <BackgammonDiagram Request="BuildSolutionRequest(current, review)"
                                   Options="BoardOptions"
                                   OnDiceClicked="NextAsync" />
            }
            else if (current is CubeDecision)
            {
                @* Cube answering: the board region is board-only. The cube answer
                   is entered by the BackgammonCubeActions radios in the action row
                   below — not on the board — so this is the same read-only shape as
                   the review branch (a bare BackgammonDiagram in Problem mode). That
                   parity is the arc's whole point: within a view mode the board sizes
                   identically across cube-answering, play-answering, and review. The
                   maximize mode reverses that deliberately and only across the mode
                   boundary — see BoardOptions and SPEC-quiz-view.md §2. *@
                <BackgammonDiagram Request="BuildRenderRequest(current)"
                                   Options="BoardOptions" />
            }
            else
            {
                @* Keyed on the problem's place in the run — its stream slot,
                   unique to each presented problem — so every landing mounts a
                   fresh entry (SPEC-quiz-history.md §5: a play in progress is
                   discarded on leaving a problem). The entry resets itself only
                   when its request describes a different position, and two
                   problems of a run can share one, so a landing from one to the
                   other would otherwise keep the half-built play. *@
                <BackgammonPlayEntry @ref="_playEntry"
                                     @key="Controller.ProblemNumber"
                                     Request="BuildRenderRequest(current)"
                                     Options="BoardOptions"
                                     OnPlayCompleted="HandlePlayCompleted"
                                     OnSubmitRequested="SubmitAsync" />
            }
        </div>

        <div class="board-chrome">
            @* ONE action row for every state (.action-row), not one per state —
               and the FIRST thing under the board (issue halheinrich/backgammon#148):
               the chrome reads board → action row → status strip → score panel, so
               the controls the user reaches for on every problem sit nearest the
               board, with the strip's prompt or verdict beneath them and the
               reference-only score panel last. Reordering inside the chrome block
               leaves the block's measured height alone — the same argument that
               moved the score panel to the bottom (SPEC-quiz-view.md §5) — so the
               board's flex remainder, and with it board size, is untouched by the
               move. Under maximized answering the strip and the panel are absent,
               so this row is the whole of the chrome there either way.

               THE COMPOSITION IS SPEC-quiz-view.md §4's "action row under quiz
               navigation": answering a checker play, Undo all and Undo last lead,
               then Submit; answering a cube decision, the answer pills lead, then
               Submit; at review, Continue. Then, in every state, ⏮ ◀ ▶ ⏭ — one
               render site, after whatever leads — then Notes at review, then the
               tail. ▶ took the Skip button's place and the navigation buttons took
               Redo's; both buttons are retired (SPEC-quiz-history.md §2).

               THE PRIMARY BUTTON IS LARGE AND BOLD — Submit in both answering
               branches, Continue at review (btn-lg fw-bold;
               halheinrich/backgammon#148's ruling (2)). It
               is the one control clicked once per problem, every problem, and the
               only one that changes size: the Undo pair, the navigation buttons
               and the whole trailing cluster keep Bootstrap's default. The row's
               height is that button's, and it is the same in every state by
               construction, because every state's row carries exactly one
               primary button — the fixed-height contract below gains a new
               constant, not a per-state variance.

               Transition-driving buttons disable while the controller is busy
               (the gate would no-op them anyway — this is the honest mirror);
               Show stats stays enabled: it only navigates. Each enables on its
               page-owned gate (CanSubmit, CanContinue, CanGoBack, CanGoNext,
               CanGoToLast) — one expression each. The spacebar
               (halheinrich/backgammon#149, amended by
               halheinrich/backgammon#200 and SPEC-quiz-history.md §2) reads
               CanSubmit and then CanGoNext, and calls the same SubmitAsync /
               NextAsync these buttons do, so the keyboard can never enable what
               a button shows disabled, nor act differently from it. End quiz
               keeps the row's far end (TailButtons, in the @code block below,
               says why).

               The controls are fragments in the @code block below, because the
               row-fit ruler after the row renders them a second time to measure
               them. The shared row is also what keeps the states' row heights
               equal by construction — what the board's flex remainder depends
               on, see the status strip's fixed-height contract. *@
            <div class="action-row d-flex flex-wrap gap-2 align-items-center" @ref="_actionRow">
                @if (review is not null)
                {
                    @ContinueControl
                }
                else if (current is CubeDecision cube)
                {
                    @* The cube answer lives here in the chrome, beside its own
                       Submit — the board region above is board-only. One radio
                       group leads the row: the four answers of SPEC-scoring §3
                       (halheinrich/backgammon#326), all four offered at every
                       cube decision, each pill one whole answer, so there is no
                       half answer to gate against. @bind-Value keeps
                       _completedCube current, which is what CanSubmit reads —
                       null until a pill is chosen, lit from the first click (the
                       one gate, see Quiz.razor.cs).

                       Decision is the record on screen: the row labels each
                       pill from it, so the fourth reads Too good where gammons
                       are possible and No double / Pass where they are not —
                       the decision's reading, which this page never re-derives.

                       One clearing mechanism, deliberately. The row holds no
                       state the answer does not express — its checked pill IS
                       Value, re-rendered from it — so HandleStateChanged nulling
                       _completedCube on every transition clears the row
                       outright, every landing included.

                       ShortLabels is this page's call, as the producer leaves
                       it to the host (SPEC-quiz-view.md §4): the short form
                       unless the row-fit module has measured that the full
                       form fits beside the tail (ShortCubeLabels). *@
                    <BackgammonCubeActions @bind-Value="_completedCube" Decision="cube"
                                           ShortLabels="@ShortCubeLabels" />
                    @SubmitControl
                }
                else
                {
                    @UndoControls
                    @SubmitControl
                }

                @NavigationControls

                @if (review is not null)
                {
                    @* THE DECISION'S NOTES HAVE ONE HOME (SPEC-quiz-view.md §4's
                       2026-09-15 amendment, issue halheinrich/backgammon#31): the
                       leading cluster, after the navigation buttons and before
                       the tail, at review only — the comment was written by
                       someone who knew the answer, so answering never shows it,
                       in either view mode. The page hands over the comment and
                       nothing else; the control, its overlay and whether it is
                       open are the component's, and a decision without a comment
                       renders nothing here. It is a fixed-width button, not a
                       member of the tail's shrink order, and the row's height
                       stays the primary button's. Every move off the review —
                       Continue, ▶ and ⏮ ◀ ⏭ alike, since every landing is the
                       answering state — closes the overlay by leaving this
                       branch, which unmounts it. *@
                    <DecisionNotes Comment="@current.Descriptive.Comment" />
                }

                @* The trailing cluster. It is right-aligned by TAKING the width
                   the answer instruments leave (flex-basis 0 + grow, app.css)
                   rather than by an auto margin, and it never wraps inside
                   itself: that is what makes §4's fixed-height contract hold by
                   construction once the locator joined it — a contents-sized
                   cluster decides the row's line breaks by its max-content
                   width, so it would push itself onto a second line at exactly
                   the widths where the widest problem kind needs the room. The
                   cluster shrinks instead, in a ruled order (app.css), down to
                   its floor; below that, the navigation panel folds by itself
                   (the row-fit ruler below).

                   THE XGID'S ONE HOME (SPEC-quiz-view.md §4, issue
                   halheinrich/backgammon#98). It leads the cluster — present in
                   both view modes and both states, since maximized answering
                   keeps this row — so it never obscures canvas content and never
                   teleports between modes. It leads rather than closes the
                   cluster so that End quiz keeps the far end of the row, which
                   is halheinrich/backgammon#57's mitigation and not this badge's to spend.

                   THE LOCATOR HAS THE SAME ONE HOME (SPEC-quiz-view.md §4's
                   2026-08-21 amendment, issue halheinrich/backgammon#115), and
                   for the same reason the badge does: maximized answering drops
                   the producer's title strip, which was the only surface naming
                   the file, and a money problem carries no score to frame it by.
                   It follows the XGID because the two together are the position's
                   provenance, and precedes the buttons because End quiz still
                   keeps the far end. Its three facts are bound one by one rather
                   than by handing the component the whole record: what this
                   chip displays IS its contract, and a wider parameter would
                   let it grow a fourth fact without a ruling. Display only —
                   none of them reaches ProblemKey, the dedupe or the stats
                   document (see ProblemLocator, and SPEC-stats-identity.md for
                   why file position is deliberately not identity).

                   The game and move numbers are the record's as the producer
                   states them: null for a standalone .xgp position, which
                   belongs to no game (halheinrich/backgammon#124), so the chip
                   shows the file name alone there and says nothing in their
                   place. *@
                <div class="action-row-tail d-flex flex-nowrap gap-2 align-items-center">
                    <XgidLabel Xgid="@current.Xgid" />
                    <ProblemLocator SourceFile="@current.SourceFile"
                                    Game="current.Game"
                                    MoveNumber="current.MoveNumber" />
                    @TailButtons
                </div>
            </div>

            @* THE ROW-FIT RULER (SPEC-quiz-view.md §4: halheinrich/backgammon#264's
               ruling of 2026-10-03 — the row narrows, the board keeps its
               height — and the cube labels' switch). Invisible and inert
               (app.css), it renders the row's widest compositions from the very
               fragments the row renders, so the fonts actually rendering size
               both alike, and wwwroot/js/actionRowFit.js reads each line's width:

               - data-ruler="lead": the two answer rows in their narrowest form —
                 Undo all, Undo last, Submit and ⏮ ◀ ▶ ⏭; and the cube pills in
                 their short form, with Submit and the four, once a cube decision
                 has been on this page (RulerCube). The widest of them, with the
                 tail's floor, is the budget the navigation panel folds by — one
                 budget for every state, so no state's board or chrome differs
                 from another's. The review row is not a line: Continue and
                 Notes replace Undo all, Undo last and Submit, two buttons for
                 three, and it is narrower in any font.
               - data-ruler="full-cube", while a cube decision is answered: the
                 full-label row, the pills at their widest selection (the
                 fourth answer, bold), which the labels' switch compares with
                 the row's actual width.
               - data-ruler="tail": the tail at its floor (app.css), its locator
                 showing three-digit coordinates (RulerCoordinate) whatever the
                 problem, so the budget does not move from one problem, or one
                 file, to the next.

               Its controls take no input (inert) and are hidden from assistive
               technology; nothing reads them but the module. *@
            <div class="action-row-ruler" aria-hidden="true" inert @ref="_actionRowRuler">
                <div class="action-row-ruler-line d-flex gap-2 align-items-center" data-ruler="lead">
                    @UndoControls
                    @SubmitControl
                    @NavigationControls
                </div>
                @if (RulerCube is { } rulerCube)
                {
                    <div class="action-row-ruler-line d-flex gap-2 align-items-center" data-ruler="lead">
                        <BackgammonCubeActions Value="RulerSelection" ValueChanged="RulerSelectionIgnored" Decision="rulerCube" ShortLabels="true" />
                        @SubmitControl
                        @NavigationControls
                    </div>
                }
                @if (review is null && current is CubeDecision answeredCube)
                {
                    <div class="action-row-ruler-line d-flex gap-2 align-items-center" data-ruler="full-cube">
                        <BackgammonCubeActions Value="RulerSelection" ValueChanged="RulerSelectionIgnored" Decision="answeredCube" ShortLabels="false" />
                        @SubmitControl
                        @NavigationControls
                    </div>
                }
                <div class="action-row-ruler-line action-row-ruler-floor d-flex flex-nowrap gap-2 align-items-center"
                     data-ruler="tail">
                    <XgidLabel Xgid="@current.Xgid" />
                    <ProblemLocator SourceFile="@null" Game="RulerCoordinate" MoveNumber="RulerCoordinate" />
                    @TailButtons
                </div>
            </div>

            @* Mode-invariant status strip, below the action row (issue
               halheinrich/backgammon#148 moved the row above it — its comment
               carries the order): present in every composition EXCEPT
               maximized answering, at a fixed height, so the chrome's total
               height — and therefore the board's flex remainder, and therefore
               the board size — is identical across the answering and review
               states and across questions *within a view mode*. While answering
               it carries a neutral prompt (legend line empty); at review the
               legend line and the verdict band fill in. Content changes; the box
               never does (long content clamps inside the fixed lines — see
               app.css).

               Suppressed under MaximizedAnswering along with the score panel
               below: SPEC-quiz-view.md §4's chrome-suppression leg. The user
               accepted losing the neutral prompt (and the progress indicator)
               for the answering half of each problem — review restores both,
               every problem. *@
            @if (!MaximizedAnswering)
            {
                <div class="status-strip">
                    <div class="status-legend text-muted small">
                        @(review is not null ? SolutionLegend(review, current) : null)
                    </div>
                    <div class="status-verdict alert @StatusVerdictColor(review)" role="status">
                        <span class="status-verdict-text">@StatusText(review, current)</span>
                    </div>
                </div>
            }

            @* The ongoing-stats strip, at the BOTTOM of the page — below the
               status strip, which since issue halheinrich/backgammon#148 is itself
               below the action row (SPEC-quiz-view.md §5 put this panel last; it
               used to sit above the strip). It is reference material read between
               problems, not while deciding one, so it belongs below the controls
               the user is actually reaching for; and the board wants the space
               nearest itself given to the chrome that speaks to the problem in
               hand (the strip's verdict and prompt).

               Reordering inside the chrome block does not change the block's
               total measured height, so the board's flex remainder — and
               therefore board size — is untouched by the move. That is what lets
               this ride alongside the maximize mode without the two interacting.

               Done and Stats render their own ScorePanel with their own
               parameters and are deliberately untouched: one component, one
               move.

               Suppressed under MaximizedAnswering with the status strip above —
               which is also where the "Problem N of M" counter goes, the
               progress indicator §4 ratifies losing for the answering half of
               each problem. *@
            @if (!MaximizedAnswering)
            {
                <ScorePanel Score="Controller.Score"
                            Skipped="Controller.SkippedCount"
                            Source="@Controller.Name"
                            ProblemNumber="Controller.ProblemNumber"
                            ProblemCount="Controller.ProblemCount" />
            }
        </div>
    }
</div>

@code {
    // The action row's controls, as fragments: the row renders each once, and
    // the row-fit ruler renders the same fragments again, inert and invisible,
    // so what is measured is what is shown (see the ruler above). They read
    // the page's own gates and call its own handlers; nothing here decides.

    /// <summary>Continue, the solution view's primary button: ▶'s method under the view's own name.</summary>
    private RenderFragment ContinueControl => @<button class="btn btn-primary btn-lg fw-bold" disabled="@(!CanContinue)"
                                                         @onclick="NextAsync">
        Continue
    </button>;

    /// <summary>Submit, the answering states' primary button — large and bold, the one control clicked on every problem.</summary>
    private RenderFragment SubmitControl => @<button class="btn btn-primary btn-lg fw-bold" disabled="@(!CanSubmit)"
                                                       @onclick="SubmitAsync">
        Submit
    </button>;

    /// <summary>
    /// Undo all and Undo last, leading the checker answer row
    /// (SPEC-quiz-view.md §4), Undo all first. Busy-only, deliberately not
    /// "_playEntry is not null": that @ref is assigned *after* the render that
    /// creates the entry, so the branch's first render always read null and
    /// disabled both buttons — and nothing re-renders this page during
    /// click-by-click assembly, so they stayed disabled until the play
    /// completed. The branch already guarantees an entry is rendered (a
    /// checker play), and a click can only land after the ref is assigned, so
    /// the null term tested nothing the branch had not already established.
    /// See UndoLast.
    /// </summary>
    private RenderFragment UndoControls => @<text>
        <button class="btn btn-outline-secondary" disabled="@Controller.IsBusy" @onclick="UndoAll">
            Undo all
        </button>
        <button class="btn btn-outline-secondary" disabled="@Controller.IsBusy" @onclick="UndoLast">
            Undo last
        </button>
    </text>;

    /// <summary>
    /// ⏮ ◀ ▶ ⏭ — SPEC-quiz-history.md §2's controls, compact icon buttons, in
    /// both states, rendered in the row once. Each button's accessible name and
    /// tooltip are its words, the inline-SVG glyph hidden from assistive
    /// technology. ▶ is called Skip where a press would add to the skip count
    /// and Next elsewhere — the run's rule, read as
    /// Controller.NextAddsToSkipCount and never rebuilt here. ⏮ and ◀ share one
    /// gate (unavailable on the first problem), ⏭ is unavailable on the
    /// frontier, and ▶ only while busy.
    /// </summary>
    private RenderFragment NavigationControls => @<div class="quiz-nav d-flex gap-1" role="group" aria-label="@NavigationGroupName">
        <button class="btn btn-outline-secondary action-row-icon" disabled="@(!CanGoBack)"
                aria-label="@GoToFirstName" title="@GoToFirstName" @onclick="GoToFirst">
            <svg viewBox="0 0 16 16" width="1em" height="1em" aria-hidden="true" focusable="false">
                <path d="M3 2h2v12H3zM14 2.5v11L6 8z" fill="currentColor" />
            </svg>
        </button>
        <button class="btn btn-outline-secondary action-row-icon" disabled="@(!CanGoBack)"
                aria-label="@BackName" title="@BackName" @onclick="GoBack">
            <svg viewBox="0 0 16 16" width="1em" height="1em" aria-hidden="true" focusable="false">
                <path d="M12 2.5v11L4 8z" fill="currentColor" />
            </svg>
        </button>
        <button class="btn btn-outline-secondary action-row-icon" disabled="@(!CanGoNext)"
                aria-label="@NextButtonName" title="@NextButtonName" @onclick="NextAsync">
            <svg viewBox="0 0 16 16" width="1em" height="1em" aria-hidden="true" focusable="false">
                <path d="M4 2.5v11L12 8z" fill="currentColor" />
            </svg>
        </button>
        <button class="btn btn-outline-secondary action-row-icon" disabled="@(!CanGoToLast)"
                aria-label="@GoToLastName" title="@GoToLastName" @onclick="GoToLast">
            <svg viewBox="0 0 16 16" width="1em" height="1em" aria-hidden="true" focusable="false">
                <path d="M2 2.5v11L10 8zM11 2h2v12h-2z" fill="currentColor" />
            </svg>
        </button>
    </div>;

    /// <summary>
    /// Show stats and End quiz, closing the trailing cluster as icon buttons
    /// (SPEC-quiz-view.md §4, halheinrich/backgammon#264's ruling of
    /// 2026-10-03: "Their names stay as their tooltips and accessible names,
    /// and End quiz keeps the far end"). The glyphs are Bootstrap Icons'
    /// bar-chart-line and box-arrow-right, inline.
    ///
    /// <para>
    /// Show stats only navigates, so it never disables. End quiz
    /// (halheinrich/backgammon#57) IS a transition — it retires the enumerator
    /// and finishes the run — so it disables on IsBusy. It keeps the far end of
    /// the row, as far from the buttons a user clicks over and over (Submit,
    /// Continue) as the row allows: that distance is the whole mitigation,
    /// since the control is one-click and acts immediately, ruled so
    /// deliberately, with no confirmation step to catch a misclick. It is
    /// styled like its neighbours rather than as a danger action, because
    /// ending a run early is a normal way to finish one — Done receives it as
    /// the completed quiz it is.
    /// </para>
    /// </summary>
    private RenderFragment TailButtons => @<text>
        <button class="btn btn-outline-secondary action-row-icon"
                aria-label="@ShowStatsName" title="@ShowStatsName" @onclick="ShowStats">
            <svg viewBox="0 0 16 16" width="1em" height="1em" aria-hidden="true" focusable="false">
                <path d="M11 2a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v12h.5a.5.5 0 0 1 0 1H.5a.5.5 0 0 1 0-1H1v-3a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3h1V7a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7h1zm1 12h2V2h-2zm-3 0V7H7v7zm-5 0v-3H2v3z" fill="currentColor" />
            </svg>
        </button>
        <button class="btn btn-outline-secondary action-row-icon" disabled="@Controller.IsBusy"
                aria-label="@EndQuizName" title="@EndQuizName" @onclick="EndQuizAsync">
            <svg viewBox="0 0 16 16" width="1em" height="1em" aria-hidden="true" focusable="false">
                <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0z" fill="currentColor" />
                <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z" fill="currentColor" />
            </svg>
        </button>
    </text>;
}
