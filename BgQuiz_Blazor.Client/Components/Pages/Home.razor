@page "/"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using BgFolderAccess_Razor
@using BgQuiz_Blazor.Client.Quiz
@using XgFilter_Razor
@using XgFilter_Razor.Components
@using XgFilter_Lib
@using XgFilter_Lib.Enums

<PageTitle>BgQuiz</PageTitle>

<div class="container py-3 @(IsBusy ? "app-busy" : null)">
    <h1>BgQuiz</h1>

    @if (StorageCondition.Occurrence is not null && !StorageCondition.IsDismissed)
    {
        <Notice id="storageUnavailableNotice" Kind="NoticeKind.Warning"
                Announcement="NoticeAnnouncement.Polite" Dismissible="true"
                @bind-Dismissed:get="false"
                @bind-Dismissed:set="_ => StorageCondition.Dismiss()">
            BgQuiz had trouble using your browser's storage. You can keep using
            it, but some choices may not be remembered next time.
        </Notice>
    }

    @* A reload mid-quiz: the live mark is the one thing that survives it, so this boot can
       say the quiz was reset. One-shot and component-held: the occurrence is this boot's,
       the mark it read is already cleared, and a navigate-back finds nothing to show. *@
    @if (_showReloadNotice)
    {
        <Notice id="reloadNotice" Kind="NoticeKind.Information" Announcement="NoticeAnnouncement.Polite"
                Dismissible="true"
                @bind-Dismissed:get="false"
                @bind-Dismissed:set="_ => _showReloadNotice = false">
            Your previous quiz was reset by the page reload — quiz progress
            doesn't survive a full reload.
        </Notice>
    }

    <fieldset disabled="@IsBusy">

    <div class="mb-3" style="max-width:800px">
        <label class="form-label" for="pickProblemFolder">
            Problem-set folder
            <small class="text-muted">
                (a local folder of .xg / .xgp files — parsed in your browser, never uploaded)
            </small>
        </label>
        <div class="d-flex flex-wrap gap-2">
            <button type="button" id="pickProblemFolder" class="btn btn-outline-primary"
                    disabled="@IsBusy" @onclick="PickFolderAsync">
                Choose folder…
            </button>
            @* Resample (SPEC-filtering.md §4): another draw of the held folder at the limits,
               without the picker — offered exactly while another draw could hold different
               files, the producer's per-kind report read, and placed as Hal asked
               (halheinrich/backgammon#416). It keeps the setup and replaces only the sample. *@
            @if (Setup is { CanResample: true })
            {
                <button type="button" id="resampleProblemFolder" class="btn btn-outline-primary"
                        disabled="@IsBusy" @onclick="ResampleAsync">
                    Resample
                </button>
            }
        </div>

        @if (Setup is null)
        {
            <div class="text-muted small mt-1" role="status">
                @FolderPickDisplay.SupportedBrowsers
            </div>
            @if (_fsAccessAvailable)
            {
                <div class="text-muted small mt-1" role="status">
                    Your browser will ask about the selected folder, near the address bar:
                    <ol class="mb-0 mt-1">
                        <li>
                            <strong>To view the selected folder's files — required.</strong>
                            Nothing works without it: decline and no folder is picked at all.
                        </li>
                        <li>
                            <strong>To save files into the folder — optional.</strong>
                            The quiz runs either way; without it,
                            @(FolderPickDisplay.WriteAccessConsequence).
                        </li>
                    </ol>
                </div>
            }
            else
            {
                <div class="text-muted small mt-1" role="status">
                    If choosing a folder opens nothing at all,
                    @(FolderPickDisplay.DeadPickVerdict) — there's nothing more to
                    try here.
                </div>
            }
        }

        <input type="file" id="problemFolderFallback" webkitdirectory class="d-none"
               @ref="_fallbackInput" @onchange="HandleFallbackPickedAsync"
               @oncancel="HandleFallbackCancelled" />

        @if (App.Phase == QuizPhase.Loading)
        {
            <div class="text-muted small mt-1" role="status" id="loadingProgress">
                @if (App.Progress is { } progress)
                {
                    <text>Reading file @Math.Min(progress.FilesRead + 1, progress.FileCount) of @progress.FileCount…</text>
                }
                else
                {
                    <text>Reading the folder…</text>
                }
            </div>
        }

        @if (Setup is { } setup)
        {
            <div class="text-muted small mt-1 d-flex align-items-center gap-2">
                <ProblemFolderLabel Description="@setup.Summary" />
                <button type="button" class="btn btn-link btn-sm p-0 align-baseline"
                        disabled="@IsBusy" @onclick="ClearSetupAsync">
                    Clear
                </button>
            </div>

            @if (!setup.Sample.HoldsEveryMatchingFile && !setup.TruncationNoticeDismissed)
            {
                <Notice id="truncationNotice" class="mt-2" Kind="NoticeKind.Warning"
                        Announcement="NoticeAnnouncement.Polite" Dismissible="true"
                        @bind-Dismissed:get="false"
                        @bind-Dismissed:set="_ => setup.TruncationNoticeDismissed = true">
                    @foreach (var kind in setup.Sample.Kinds.Where(kind => kind.OmittedCount > 0))
                    {
                        <div>
                            Using @kind.MaxFileCount @kind.Extension files chosen at random;
                            @kind.OmittedCount more @(kind.OmittedCount == 1 ? "was" : "were") not read.
                        </div>
                    }
                </Notice>
            }

            @* Which stats rung this folder landed on. The "will be saved" promise is made only
               while neither forecast below says otherwise; the no-grant line never says the
               user declined, since the browser can refuse to ask. *@
            @if (!setup.StatsCapabilityNoticeDismissed)
            {
                @switch (setup.Capability)
                {
                    case FolderWriteCapability.Enabled when setup.Stats.Unreadable || setup.Stats.Unwritable:
                        break;
                    case FolderWriteCapability.Enabled:
                        <Notice id="statsCapabilityNotice" class="mt-2" Kind="NoticeKind.Information"
                                Announcement="NoticeAnnouncement.Polite" Dismissible="true"
                                @bind-Dismissed:get="false"
                                @bind-Dismissed:set="_ => setup.StatsCapabilityNoticeDismissed = true">
                            Your lifetime quiz stats will be saved to
                            <strong>@QuizStatsFile.FileName</strong> in this folder.
                        </Notice>
                        break;
                    case FolderWriteCapability.BrowserUnsupported:
                        <Notice id="statsCapabilityNotice" class="mt-2" Kind="NoticeKind.Warning"
                                Announcement="NoticeAnnouncement.Polite" Dismissible="true"
                                @bind-Dismissed:get="false"
                                @bind-Dismissed:set="_ => setup.StatsCapabilityNoticeDismissed = true">
                            Your browser can't save quiz stats — the quiz runs without them.
                        </Notice>
                        break;
                    case FolderWriteCapability.PermissionDenied:
                        <Notice id="statsCapabilityNotice" class="mt-2" Kind="NoticeKind.Warning"
                                Announcement="NoticeAnnouncement.Polite" Dismissible="true"
                                @bind-Dismissed:get="false"
                                @bind-Dismissed:set="_ => setup.StatsCapabilityNoticeDismissed = true">
                            @(FolderPickDisplay.WriteAccessNotGranted) — the quiz runs, but
                            @(FolderPickDisplay.WriteAccessConsequence).
                        </Notice>
                        break;
                }
            }

            @* The forecasts the pick-time probe can make: said here, before Start. The quiz
               page's own notices stay, since the file can change in between. *@
            @if (setup.Stats.Unreadable && !setup.StatsUnreadableNoticeDismissed)
            {
                <Notice id="statsUnreadableForecastNotice" class="mt-2" Kind="NoticeKind.Warning"
                        Announcement="NoticeAnnouncement.Polite" Dismissible="true"
                        @bind-Dismissed:get="false"
                        @bind-Dismissed:set="_ => setup.StatsUnreadableNoticeDismissed = true">
                    @FolderPickDisplay.StatsUnreadableForecast
                </Notice>
            }
            @if (setup.Stats.Unwritable && !setup.StatsUnwritableNoticeDismissed)
            {
                <Notice id="statsUnwritableForecastNotice" class="mt-2" Kind="NoticeKind.Warning"
                        Announcement="NoticeAnnouncement.Polite" Dismissible="true"
                        @bind-Dismissed:get="false"
                        @bind-Dismissed:set="_ => setup.StatsUnwritableNoticeDismissed = true">
                    @FolderPickDisplay.StatsUnwritableForecast
                </Notice>
            }
            @if (setup.Stats.SetAsideForecast is { } forecastSetAsideName && !setup.StatsRetirementNoticeDismissed)
            {
                <Notice id="statsRetirementForecastNotice" class="mt-2" Kind="NoticeKind.Information"
                        Announcement="NoticeAnnouncement.Polite" Dismissible="true"
                        @bind-Dismissed:get="false"
                        @bind-Dismissed:set="_ => setup.StatsRetirementNoticeDismissed = true">
                    Your stats file was written by an earlier version of BgQuiz and can't be
                    carried forward. When you start a quiz it will be set aside as
                    <strong>@forecastSetAsideName</strong> — nothing is deleted — and a new
                    <strong>@QuizStatsFile.FileName</strong> started, so your lifetime stats
                    will begin again.
                </Notice>
            }
        }

        @if (App.Finished is { EndedByNewSample: true, EndedNoticeDismissed: false } endedRun)
        {
            <Notice id="quizEndedByNewSampleNotice" class="mt-2" Kind="NoticeKind.Information"
                    Announcement="NoticeAnnouncement.Polite" Dismissible="true"
                    @bind-Dismissed:get="false"
                    @bind-Dismissed:set="_ => endedRun.EndedNoticeDismissed = true">
                Reading new files finished the quiz you had in progress —
                <a href="done">see its summary</a>.
            </Notice>
        }

        <Notice id="cancelledPickNotice" class="mt-2" Kind="NoticeKind.Warning"
                Announcement="NoticeAnnouncement.Polite" Dismissible="true"
                @bind-Dismissed:get="!_cancelledPickNotice"
                @bind-Dismissed:set="_ => _cancelledPickNotice = false">
            No folder was picked —
            choose a folder and, if your browser asks to view its files,
            allow that request.
            @if (_fsAccessAvailable)
            {
                <text>
                    If no folder chooser opened,
                    @(FolderPickDisplay.DeadPickVerdict).
                </text>
            }
        </Notice>

        <Notice id="emptyFolderNotice" class="mt-2" Kind="NoticeKind.Warning"
                Announcement="NoticeAnnouncement.Polite" Dismissible="true"
                @bind-Dismissed:get="!_emptyFolderNotice"
                @bind-Dismissed:set="_ => _emptyFolderNotice = false">
            No .xg / .xgp files found directly in that folder.
        </Notice>

        @* An empty draw of the held folder replaces nothing, and the line says so: the gesture
           must not end on an unchanged page with nothing said. *@
        <Notice id="emptyResampleNotice" class="mt-2" Kind="NoticeKind.Warning"
                Announcement="NoticeAnnouncement.Polite" Dismissible="true"
                @bind-Dismissed:get="!_emptyResampleNotice"
                @bind-Dismissed:set="_ => _emptyResampleNotice = false">
            Resample found no .xg / .xgp files directly in that folder, so the files already
            read are still the ones in use.
        </Notice>

        <Notice class="mt-2" Kind="NoticeKind.Error" Announcement="NoticeAnnouncement.Assertive"
                Dismissible="true"
                @bind-Dismissed:get="string.IsNullOrEmpty(_pickError)"
                @bind-Dismissed:set="_ => _pickError = null">
            <strong>Could not read the folder:</strong> @_pickError
        </Notice>
    </div>

    @if (Setup is { } loadedSetup)
    {
        <FilterSurface Storage="loadedSetup.Documents"
                       CanPersist="loadedSetup.Capability == FolderWriteCapability.Enabled"
                       PersistDisabledReason="@SavedFiltersDisabledReason" />

        RenderFragment<SourceReport> rejectedFiles = report =>
            @<ul class="mb-0">
                @foreach (var rejection in report.Rejected)
                {
                    <li><code>@rejection.SourceName</code> — @rejection.Reason.Message</li>
                }
            </ul>;

        @* The count is filter-only; with a mix in effect the number is the pool the mix
           draws from, which the quiz can fall far short of, so the line says so. *@
        RenderFragment mixCaveat =
            @<text>
                Your mix applies: the quiz is drawn from these matches rather than
                presenting all of them, so the quiz itself can be much smaller.
            </text>;

        @if (loadedSetup.Loaded.Report is { AllRejected: true } allRejected)
        {
            <Notice id="allRejectedNotice" class="mb-3" Kind="NoticeKind.Warning"
                    Announcement="NoticeAnnouncement.Polite">
                <div><strong>None</strong> of the selected problem files could be read, so there are no decisions to count:</div>
                @rejectedFiles(allRejected)
            </Notice>
        }
        else if (IsCounting)
        {
            <div class="text-muted small mb-3" role="status">Counting matching decisions…</div>
        }
        else if (CurrentSelection is { AnswerTypes.Total: 0 })
        {
            <Notice id="noMatchNotice" class="mb-3" Kind="NoticeKind.Warning"
                    Announcement="NoticeAnnouncement.Polite">
                <strong>0</strong> decisions match your filters.
                @if (MixDrawsFromTheMatches)
                {
                    @mixCaveat
                }
            </Notice>
        }
        else if (CurrentSelection is { AnswerTypes: var pool, DuplicatesCollapsed: var collapsed })
        {
            <div class="text-muted small mb-3" role="status">
                <div>
                    <strong>@pool.Total</strong>
                    @(pool.Total == 1 ? "decision matches" : "decisions match") your filters.
                    @if (collapsed > 0)
                    {
                        <text>
                            Repeated positions are counted once. @collapsed
                            @(collapsed == 1 ? "duplicate is" : "duplicates are") omitted.
                        </text>
                    }
                    else
                    {
                        <text>There are no repeated positions.</text>
                    }
                    @if (loadedSetup.Loaded.ForcedPlaysSetAside > 0)
                    {
                        <text>
                            @loadedSetup.Loaded.ForcedPlaysSetAside forced
                            @(loadedSetup.Loaded.ForcedPlaysSetAside == 1 ? "play was" : "plays were") set aside: a roll with one legal play asks nothing.
                        </text>
                    }
                    @if (MixDrawsFromTheMatches)
                    {
                        @mixCaveat
                    }
                </div>
                <div class="mt-1">
                    By answer type:
                    <ul class="list-inline d-inline mb-0">
                        @foreach (var bucket in AnswerTypeDisplay.Buckets(pool))
                        {
                            <li class="list-inline-item">@bucket.Label: <strong>@bucket.Count</strong></li>
                        }
                    </ul>
                </div>
            </div>
        }
        else if (FilterInEffect is not null)
        {
            @* In effect but not counted: an edit emptied the draft (the empty selection needs
               no Apply), or the last count failed. The count follows a commit, never typing. *@
            <div class="text-muted small mb-3" role="status" id="countFollowsCommit">The count follows Apply or Clear.</div>
        }

        @if (loadedSetup.Loaded.Report is { AllRejected: false, Rejected.Count: > 0 } incomplete)
        {
            <Notice id="rejectedFilesNotice" class="mb-3" Kind="NoticeKind.Warning"
                    Announcement="NoticeAnnouncement.Polite">
                <div>
                    <strong>@incomplete.Rejected.Count</strong> of @incomplete.AttemptedCount files could not
                    be read, so this selection is incomplete:
                </div>
                @rejectedFiles(incomplete)
            </Notice>
        }

        @* Visible means in effect (SPEC-filtering.md §5): the panel is on screen exactly while
           the setting is on and this folder holds stats, and the rows on it compose the next
           Start. Keyed on the setup, so each pick mounts it afresh. *@
        @if (App.MixInEffect)
        {
            <MixPanel @key="loadedSetup" />
        }
    }

    <fieldset class="mb-3" id="problemOrder">
        <legend class="form-label fs-6 mb-1">Order</legend>
        @foreach (var order in QuizSettings.Orders)
        {
            var id = $"problemOrder{order}";
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="problemOrder" id="@id"
                       checked="@(Settings.Order == order)"
                       @onchange="() => Settings.SetOrderAsync(order)" />
                <label class="form-check-label" for="@id">@order.ToLabel()</label>
            </div>
        }
    </fieldset>

    <button class="btn btn-primary" disabled="@(!CanStart || IsBusy)" @onclick="StartQuizAsync">
        Start Quiz
    </button>

    @if (Setup is null)
    {
        <small class="text-muted ms-2">Pick a folder containing .xg / .xgp files to enable Start.</small>
    }
    else if (FilterInEffect is null)
    {
        <small class="text-muted ms-2">Apply the filters above to enable Start.</small>
    }
    else if (Setup.Loaded.Report.AllRejected)
    {
        <small class="text-muted ms-2">No selected problem file could be read — pick a folder with readable problem files to enable Start.</small>
    }
    else if (CurrentSelection is { AnswerTypes.Total: 0 })
    {
        <small class="text-muted ms-2">No problems match the filters — adjust and re-apply them to enable Start.</small>
    }
    else if (App.MixForStart is null)
    {
        <small class="text-muted ms-2">Mix applies but isn't valid — fix it or turn the mix off.</small>
    }

    <Notice class="mt-3" Kind="NoticeKind.Error" Announcement="NoticeAnnouncement.Assertive"
            Dismissible="true"
            @bind-Dismissed:get="string.IsNullOrEmpty(_startError)"
            @bind-Dismissed:set="_ => _startError = null">
        <strong>Could not start quiz:</strong> @_startError
    </Notice>

    @* The weighted start was refused: the stats stopped being readable between the pick
       and Start, and running silently unweighted would substitute a quiz the user did not
       ask for. The one-click escape runs this quiz unweighted; the mix rows are kept. *@
    @if (_mixRefused)
    {
        <Notice class="mt-3" Kind="NoticeKind.Warning" Announcement="NoticeAnnouncement.Assertive">
            <p class="mb-2">
                Lifetime stats aren't available for this quiz (@MixDisplay.RefusalReason),
                so the weighted mix can't be applied.
            </p>
            <button class="btn btn-outline-primary btn-sm" id="startWithoutMix"
                    disabled="@IsBusy" @onclick="StartWithoutMixAsync">
                Start without mix
            </button>
            <span class="small text-muted ms-2">
                runs this one quiz unweighted — or turn the mix off in
                <em>Settings</em> to stop weighting altogether; your mix rows are
                kept either way.
            </span>
        </Notice>
    }

    @if (!string.IsNullOrEmpty(_noMatchNotice))
    {
        <Notice class="mt-3" Kind="NoticeKind.Warning" Announcement="NoticeAnnouncement.Polite">
            @_noMatchNotice
        </Notice>
    }

    </fieldset>

    @if (App.HasStarted && !App.IsFinished)
    {
        <button class="btn btn-primary mt-3" @onclick="BackToQuiz">
            Back to quiz
        </button>
    }

    <div class="text-muted small mt-4">
        <span id="appVersion">v@(AppInfo.Version)</span>
        · <a href="@AppInfo.FeedbackMailto">Send feedback</a>
    </div>
</div>
