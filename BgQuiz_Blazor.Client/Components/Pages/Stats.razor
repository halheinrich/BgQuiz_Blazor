@page "/stats"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using BgQuiz_Blazor.Client.Quiz

@inject QuizController Controller
@inject PickedProblemFolder Folder
@inject NavigationManager Nav

<PageTitle>BgQuiz — Stats</PageTitle>

<div class="container py-3">
    <h1>Quiz progress</h1>

    <ScorePanel Score="Controller.Score"
                Skipped="Controller.SkippedCount"
                Source="@Controller.Name"
                Heading="Progress so far" />

    @* The problem folder leads the heading, as on Done
       (halheinrich/backgammon#199) — see Done.razor for the shape. *@
    <ScoreBreakdown Score="Controller.Score" Heading="Detailed evaluation so far">
        <HeadingLead>
            <ProblemFolderLabel Description="@Folder.DisplayName" />
        </HeadingLead>
    </ScoreBreakdown>

    <button class="btn btn-primary" @onclick="BackToQuiz">
        Back to quiz
    </button>
</div>
