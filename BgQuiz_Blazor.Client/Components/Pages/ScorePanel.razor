@using BgGame_Lib

@code {
    [Parameter, EditorRequired] public QuizScore Score { get; set; } = QuizScore.Empty;
    [Parameter] public int Skipped { get; set; }
    [Parameter] public string? Source { get; set; }
    [Parameter] public string? Heading { get; set; }

    // Problem-position indicator ("Problem N of M" / "Problem N"), rendered
    // only when ProblemNumber is supplied — the Quiz page passes the
    // controller's stream position and total; the end-of-quiz (Done) and
    // mid-quiz stats surfaces omit it. Both numbers count stream slots
    // (auto-skipped no-choice positions included) — see
    // QuizController.ProblemNumber for the convention and its trade-off.
    [Parameter] public int? ProblemNumber { get; set; }
    [Parameter] public int? ProblemCount { get; set; }

    // Accuracy is library-provided in [0, 1] (0 on an empty segment); the ×100
    // percentage rendering is a display concern that lives here, per
    // ScoreSegment's documented split — the same pattern ScoreBreakdown uses.
    private double PercentCorrect => Score.Total.Accuracy * 100;

    // The accuracy suffix's widest form. Before the first submission there is
    // no percentage to show, and the line would grow by this much the moment
    // one arrives — so it is rendered invisibly until then, reserving its own
    // width from the same text (SPEC-quiz-view.md §2, issue
    // halheinrich/backgammon#111). app.css decides where the reservation holds.
    private const string WidestPercentSuffix = " (100%)";
}

@* One fixed-height line where the line fits (SPEC-quiz-view.md §2, ruled
   2026-09-22, issue halheinrich/backgammon#111): app.css states the contract
   and the width it starts at. What this markup owes it is a line whose width
   does not change between answering and review — the reserved suffix below —
   and a folder name that cannot run long: the app's one middle cut
   (NameTruncation, shared with the problem locator chip), with the full
   name on the title. *@
<div class="score-panel mb-2 small text-muted">
    @if (!string.IsNullOrEmpty(Heading))
    {
        <strong class="me-2">@Heading</strong>
    }
    @if (!string.IsNullOrEmpty(Source))
    {
        <span class="me-3">Set: <code class="score-panel-source" title="@Source">@NameTruncation.MiddleTruncate(Source)</code></span>
    }
    @if (ProblemNumber is { } n)
    {
        <span class="me-3 problem-position">
            Problem <strong>@n</strong>
            @if (ProblemCount is { } m)
            {
                <text> of <strong>@m</strong></text>
            }
        </span>
    }
    <span class="me-3">Submitted: <strong>@Score.Total.Submitted</strong></span>
    <span class="me-3">
        Correct: <strong>@Score.Total.Correct</strong>
        @if (Score.Total.Submitted > 0)
        {
            <text> (@PercentCorrect.ToString("0")%)</text>
        }
        else
        {
            <span class="score-panel-suffix-reserve" aria-hidden="true">@WidestPercentSuffix</span>
        }
    </span>
    <span class="me-3">Skipped: <strong>@Skipped</strong></span>
    <span>Avg loss: <strong>@Score.Total.AverageEquityLoss.ToString("0.0000")</strong></span>
</div>
