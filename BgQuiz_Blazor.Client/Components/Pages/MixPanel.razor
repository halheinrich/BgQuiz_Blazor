@using BgGame_Lib
@using BgQuiz_Blazor.Client.Quiz
@inject MixDraft Draft
@inject MixConsent Consent

@* ── MixPanel.razor ──────────────────────────────────────────────────────────
   The stats-weighted mix builder: a VIEW over the app-scoped MixDraft and
   MixConsent — an ordered list of (category, percent) rows plus the
   Random-order toggle and an optional quiz length, all owned by the draft so
   edits survive in-app navigation; and the "Mix applies" checkbox, the sole
   activation control (SPEC-filtering.md §5 Fork B), whose bit lives in the
   scoped MixConsent because the panel dies on navigation and §4 says
   navigation changes nothing. There is no committed mix and no commit
   gesture: checked = the mix shown here is in effect, and every edit that
   validates writes the built mix through to localStorage (xg_quizMix, via the
   draft — last-valid write-through; this component never touches a serializer
   or localStorage). Row order is semantic — earlier rows win contested
   overlap (producer contract) — hence the explicit ↑/↓ affordance.
──────────────────────────────────────────────────────────────────────────── *@

<div class="card mb-4" style="max-width:800px">
    <div class="card-header">
        <strong>Weighted mix</strong>
        <small class="text-muted">(optional — compose the quiz from your lifetime stats)</small>
    </div>
    <div class="card-body">

        @if (Draft.Rows.Count == 0)
        {
            <p class="text-muted small">
                No mix: the quiz takes every matching problem, as usual. Add a
                category to weight the quiz by your lifetime stats — e.g. mostly
                problems you got wrong or haven't seen lately. Needs a folder
                pick that can save stats.
            </p>
        }
        else
        {
            <p class="text-muted small">
                Rows draw in order: when categories overlap, a problem counts
                toward the <em>earlier</em> row.
            </p>
        }

        @for (var i = 0; i < Draft.Rows.Count; i++)
        {
            var row = Draft.Rows[i];
            var index = i; // capture per iteration for the lambdas below
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2 mix-row">
                <select class="form-select form-select-sm w-auto" aria-label="Category"
                        @onchange="e => HandleKindChangedAsync(index, e)">
                    @foreach (var kind in MixDraft.CategoryKinds)
                    {
                        <option value="@kind" selected="@(row.Kind == kind)">@MixDisplay.KindLabel(kind)</option>
                    }
                </select>
                @if (KindTakesParameter(row.Kind))
                {
                    <input class="form-control form-control-sm mix-param" style="max-width:90px"
                           aria-label="@ParameterLabel(row.Kind)"
                           value="@row.ParamText"
                           @oninput="e => Draft.SetParamTextAsync(index, e.Value?.ToString() ?? string.Empty)" />
                    <span class="text-muted small">@ParameterUnit(row.Kind)</span>
                }
                <input class="form-control form-control-sm mix-percent" style="max-width:80px"
                       type="number" min="1" max="100" aria-label="Percent"
                       value="@row.PercentText"
                       @oninput="e => Draft.SetPercentTextAsync(index, e.Value?.ToString() ?? string.Empty)" />
                <span class="text-muted small">%</span>
                <div class="btn-group btn-group-sm ms-auto" role="group">
                    <button type="button" class="btn btn-outline-secondary" title="Move up"
                            disabled="@(index == 0)" @onclick="() => Draft.MoveRowAsync(index, -1)">↑</button>
                    <button type="button" class="btn btn-outline-secondary" title="Move down"
                            disabled="@(index == Draft.Rows.Count - 1)" @onclick="() => Draft.MoveRowAsync(index, +1)">↓</button>
                    @* Removing the last row is an edit like any other now: the
                       blank draft builds the blank mix, which the write-through
                       persists — no auto-commit path, nothing gates Start,
                       and a checked box simply reads as passthrough. *@
                    <button type="button" class="btn btn-outline-secondary" title="Remove"
                            @onclick="() => Draft.RemoveRowAsync(index)">✕</button>
                </div>
            </div>
        }

        <div class="d-flex align-items-center gap-3 mb-3">
            @* Outline-*primary*, not the secondary grey the panel's other
               buttons wear. Adding a row is always valid — there is no state in
               which this is disabled — but at zero rows it is surrounded by
               controls that genuinely are (Random order, Quiz length, and the
               gated "Mix applies" box before a filter is applied), so in
               secondary grey it read as another switched-off control, which is
               the one reading that must never happen: it is the only way out of
               the zero-row state. Same class as Home's "Choose folder…" — the
               page's other required-but-unstarted step. *@
            <button type="button" id="mixAddRow" class="btn btn-outline-primary btn-sm"
                    @onclick="Draft.AddRowAsync">
                Add category
            </button>
            @if (Draft.Rows.Count > 0)
            {
                <span class="small @(Draft.PercentSum == 100 ? "text-muted" : "text-danger")">
                    Total: @Draft.PercentSum% @(Draft.PercentSum == 100 ? "" : "— must reach 100%")
                </span>
            }
        </div>

        <div class="mb-2 form-check">
            <input class="form-check-input" type="checkbox" id="mixRandomOrder"
                   checked="@Draft.RandomOrder" disabled="@(Draft.Rows.Count == 0)"
                   @onchange="e => Draft.SetRandomOrderAsync(e.Value is true)" />
            <label class="form-check-label" for="mixRandomOrder">
                Random order
                <small class="text-muted">(off = draw and present in file order)</small>
            </label>
        </div>

        <div class="mb-3">
            <label class="form-label" for="mixQuizLength">
                Quiz length
                <small class="text-muted">
                    (blank = every problem the categories reach@(Draft.Rows.Count == 0 ? "; needs at least one category" : ""))
                </small>
            </label>
            <input class="form-control" style="max-width:140px" id="mixQuizLength"
                   type="number" min="1" placeholder="No cap"
                   disabled="@(Draft.Rows.Count == 0)"
                   value="@Draft.LengthText"
                   @oninput="e => Draft.SetLengthTextAsync(e.Value?.ToString() ?? string.Empty)" />
        </div>

        @if (Draft.ValidationError is { } error)
        {
            <div class="text-danger small mb-2" role="status">@error</div>
        }

        @* "Mix applies" — the sole activation control (SPEC §5 Fork B):
           checked = the mix above is in effect for the next Start; there is no
           committed copy for it to diverge from. The disabled condition is
           ASYMMETRIC on purpose: only the *check* gesture is gated (CanActivate
           — the host's filter-in-effect fact, Fork A strict), so while the box
           is checked it stays operable and unchecking — the universal way out —
           is never taken away. The app flips the bit in neither direction:
           clearing the rows, breaking the mix, or editing the filter leaves the
           user's consent exactly where they put it (a checked box over the
           blank mix is honest passthrough — the zero-row copy above says so).
           Deliberately NOT disabled at zero rows, ruled. *@
        <div class="mb-2 form-check">
            <input class="form-check-input" type="checkbox" id="mixApplies"
                   checked="@Consent.Applies"
                   disabled="@(!Consent.Applies && !CanActivate)"
                   title="@ActivateDisabledTitle"
                   @onchange="HandleAppliesChanged" />
            <label class="form-check-label" for="mixApplies">
                Mix applies
                <small class="text-muted">(checked = the next quiz is drawn by the mix above)</small>
            </label>
        </div>

        @* Clear mix keeps its one honest job — deliberately removing the rows,
           with storage following the screen (the write-through persists the
           blank mix). Ungated in every state: it is a way out, never a way
           into anything. It does NOT touch the checkbox — consent is the
           user's alone. *@
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary btn-sm" id="mixClear" @onclick="Draft.ClearAsync">
                Clear mix
            </button>
        </div>

        @if (!CanActivate && !Consent.Applies && ActivateDisabledReason is not null)
        {
            <div class="form-text" id="mixActivateDisabledReason">@ActivateDisabledReason</div>
        }

    </div>
</div>
