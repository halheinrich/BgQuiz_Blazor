@using BgGame_Lib
@using BgQuiz_Blazor.Client.Quiz
@inject MixDraft Draft

@* ── MixPanel.razor ──────────────────────────────────────────────────────────
   The stats-weighted mix builder: a VIEW over the app-scoped MixDraft — an
   ordered list of (category, percent) rows plus the Random-order toggle and an
   optional quiz length, all owned by the draft so edits survive in-app
   navigation. Raises OnMixApplied on Apply, on Clear mix, and when the last row
   is removed (Clear mix and last-row removal both being an explicit apply of
   the blank mix); mere edits raise nothing — the draft notifies its subscribers
   and the start gate derives from draft-vs-committed content equality. Init
   triggers the draft's once-per-setup localStorage hydration; it never
   commits. Row order is semantic — earlier rows win contested overlap
   (producer contract) — hence the explicit ↑/↓ affordance.
   The committed mix persists as one QuizMix blob (xg_quizMix) via the draft's
   PersistAsync; this component never touches a serializer or localStorage.
──────────────────────────────────────────────────────────────────────────── *@

<div class="card mb-4" style="max-width:800px">
    <div class="card-header">
        <strong>Weighted mix</strong>
        <small class="text-muted">(optional — compose the quiz from your lifetime stats)</small>
    </div>
    <div class="card-body">

        @if (Draft.Rows.Count == 0)
        {
            <p class="text-muted small">
                No mix: the quiz takes every matching problem, as usual. Add a
                category to weight the quiz by your lifetime stats — e.g. mostly
                problems you got wrong or haven't seen lately. Needs a folder
                pick that can save stats.
            </p>
        }
        else
        {
            <p class="text-muted small">
                Rows draw in order: when categories overlap, a problem counts
                toward the <em>earlier</em> row.
            </p>
        }

        @for (var i = 0; i < Draft.Rows.Count; i++)
        {
            var row = Draft.Rows[i];
            var index = i; // capture per iteration for the lambdas below
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2 mix-row">
                <select class="form-select form-select-sm w-auto" aria-label="Category"
                        @onchange="e => HandleKindChanged(index, e)">
                    @foreach (var kind in MixDraft.CategoryKinds)
                    {
                        <option value="@kind" selected="@(row.Kind == kind)">@MixDisplay.KindLabel(kind)</option>
                    }
                </select>
                @if (KindTakesParameter(row.Kind))
                {
                    <input class="form-control form-control-sm mix-param" style="max-width:90px"
                           aria-label="@ParameterLabel(row.Kind)"
                           value="@row.ParamText"
                           @oninput="e => Draft.SetParamText(index, e.Value?.ToString() ?? string.Empty)" />
                    <span class="text-muted small">@ParameterUnit(row.Kind)</span>
                }
                <input class="form-control form-control-sm mix-percent" style="max-width:80px"
                       type="number" min="1" max="100" aria-label="Percent"
                       value="@row.PercentText"
                       @oninput="e => Draft.SetPercentText(index, e.Value?.ToString() ?? string.Empty)" />
                <span class="text-muted small">%</span>
                <div class="btn-group btn-group-sm ms-auto" role="group">
                    <button type="button" class="btn btn-outline-secondary" title="Move up"
                            disabled="@(index == 0)" @onclick="() => Draft.MoveRow(index, -1)">↑</button>
                    <button type="button" class="btn btn-outline-secondary" title="Move down"
                            disabled="@(index == Draft.Rows.Count - 1)" @onclick="() => Draft.MoveRow(index, +1)">↓</button>
                    <button type="button" class="btn btn-outline-secondary" title="Remove"
                            @onclick="() => RemoveRowAsync(index)">✕</button>
                </div>
            </div>
        }

        <div class="d-flex align-items-center gap-3 mb-3">
            @* Outline-*primary*, not the secondary grey the panel's other
               buttons wear. Adding a row is always valid — there is no state in
               which this is disabled — but at zero rows it is surrounded by
               three controls that genuinely are (Random order, Quiz length,
               Apply Mix), so in secondary grey it read as a fourth switched-off
               control, which is the one reading that must never happen: it is
               the only way out of the zero-row state. Same class as Home's
               "Choose folder…" — the page's other required-but-unstarted step. *@
            <button type="button" id="mixAddRow" class="btn btn-outline-primary btn-sm"
                    @onclick="Draft.AddRow">
                Add category
            </button>
            @if (Draft.Rows.Count > 0)
            {
                <span class="small @(Draft.PercentSum == 100 ? "text-muted" : "text-danger")">
                    Total: @Draft.PercentSum% @(Draft.PercentSum == 100 ? "" : "— must reach 100%")
                </span>
            }
        </div>

        <div class="mb-2 form-check">
            <input class="form-check-input" type="checkbox" id="mixRandomOrder"
                   checked="@Draft.RandomOrder" disabled="@(Draft.Rows.Count == 0)"
                   @onchange="e => Draft.SetRandomOrder(e.Value is true)" />
            <label class="form-check-label" for="mixRandomOrder">
                Random order
                <small class="text-muted">(off = draw and present in file order)</small>
            </label>
        </div>

        <div class="mb-3">
            <label class="form-label" for="mixQuizLength">
                Quiz length
                <small class="text-muted">
                    (blank = every problem the categories reach@(Draft.Rows.Count == 0 ? "; needs at least one category" : ""))
                </small>
            </label>
            <input class="form-control" style="max-width:140px" id="mixQuizLength"
                   type="number" min="1" placeholder="No cap"
                   disabled="@(Draft.Rows.Count == 0)"
                   value="@Draft.LengthText"
                   @oninput="e => Draft.SetLengthText(e.Value?.ToString() ?? string.Empty)" />
        </div>

        @if (Draft.ValidationError is { } error)
        {
            <div class="text-danger small mb-2" role="status">@error</div>
        }

        @* Clear mix is deliberately ungated by CanApply: it is the way *out* of
           a dirty draft (a hydrated stored mix gates Start before any filter is
           applied), so gating both would wedge the page. Apply's own two
           conditions — at least one row, and a draft that validates — are
           unchanged; the host gate is a third, independent one.

           Named for what it does, not for what it undoes (issue #87): the
           gesture blanks the builder AND commits the blank mix, so "Reset"
           promised a return to some earlier state and delivered a commitment
           instead. The sibling precedent is the filter panel's "Clear
           filters" — same shape of gesture, same honesty. *@
        <div class="d-flex gap-2">
            <button class="btn btn-primary btn-sm" id="mixApply"
                    disabled="@(!CanApply || Draft.Rows.Count == 0 || Draft.ValidationError is not null)"
                    title="@ApplyDisabledTitle"
                    @onclick="ApplyAsync">
                Apply Mix
            </button>
            <button class="btn btn-outline-secondary btn-sm" id="mixClear" @onclick="ClearAsync">
                Clear mix
            </button>
        </div>

        @if (!CanApply && ApplyDisabledReason is not null)
        {
            <div class="form-text" id="mixApplyDisabledReason">@ApplyDisabledReason</div>
        }

    </div>
</div>
