@* The decision's notes: a control that opens the comment as an overlay above
   the page (SPEC-quiz-view.md §4, amended 2026-09-15; issue
   halheinrich/backgammon#31). One component owns the control, the overlay
   and whether it is open; the host passes the comment and nothing else.
   Renders nothing when the comment is empty (see the code-behind). *@
@if (!string.IsNullOrEmpty(Comment))
{
    <button type="button" class="@ToggleClass"
            aria-haspopup="dialog" aria-expanded="@(_open ? "true" : "false")"
            aria-controls="@(_open ? _dialogId : null)"
            @ref="_toggle" @onclick="Toggle">
        @Label
    </button>
    @if (_open)
    {
        @* Covers the whole viewport beneath the dialog, so any click outside
           the notes lands here and closes them — and lands on nothing else. *@
        <div class="decision-notes-backdrop" @onclick="Close"></div>
        @* tabindex -1: focus is moved here on open, and a click on the text
           keeps focus inside, which is what lets Esc reach the handler. *@
        <dialog open id="@_dialogId" class="decision-notes" tabindex="-1"
                aria-labelledby="@HeadingId" @ref="_dialog" @onkeydown="HandleKeyDown">
            <div class="decision-notes-header">
                <h2 class="h6 m-0" id="@HeadingId">@Label</h2>
                <button type="button" class="btn-close" aria-label="@CloseLabel"
                        @onclick="Close"></button>
            </div>
            @* The text as the source stored it: rendered as a text node, never
               inspected, whitespace kept by the stylesheet (pre-wrap). *@
            <div class="decision-notes-text">@Comment</div>
        </dialog>
    }
}

@code {
    /// <summary>
    /// An inert copy of the control, for a host to measure — the quiz page's
    /// row-fit ruler, which holds the review row at its widest whatever the
    /// decision on screen (SPEC-quiz-view.md §4, "One budget from the
    /// outset"). The same button, class and caption as the control, from the
    /// same constants, so the two measure alike; without its wiring (no
    /// popup, no state, no handler), and drawn whether or not any decision has
    /// a comment. Open or closed, with a comment or without, the control
    /// draws at this width: nothing in its look depends on its state.
    /// </summary>
    internal static RenderFragment RulerCopy => @<button type="button" class="@ToggleClass">@Label</button>;
}
