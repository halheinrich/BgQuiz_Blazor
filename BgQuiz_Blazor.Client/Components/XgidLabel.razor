@* Selectable, copyable XGID badge, rendered in normal flow wherever the host
   places it. Renders nothing when the XGID is empty (see the code-behind). *@
@if (!string.IsNullOrEmpty(Xgid))
{
    <div class="xgid-label" role="group" aria-label="Position XGID">
        <code class="xgid-label-text">@Xgid</code>
        <button type="button"
                class="xgid-label-copy"
                title="Copy XGID to clipboard"
                aria-label="Copy XGID to clipboard"
                @onclick="CopyAsync">
            @(_copied ? "Copied" : "Copy")
        </button>
    </div>
}
