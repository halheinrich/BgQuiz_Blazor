<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Framework / nullable / implicit-usings / warnings-as-errors are inherited
         from the repo-root Directory.Build.props. Warnings-as-errors is kept (test
         code holds to the same bar); doc-file generation is explicitly opted out —
         a test assembly exports no API to document, and leaving it on would only
         demand XML docs on every public test fixture to satisfy CS1591. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Direct reference: this project compiles against AngleSharp.Dom types
         (rationale in Directory.Packages.props). -->
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="bunit" />
    <PackageReference Include="coverlet.collector" />
    <!-- WebApplicationFactory, for the host-pipeline wire tests. bUnit renders
         components in isolation and cannot see middleware or endpoint routing, so
         it is structurally blind to defects that live in Program.cs. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- The interactive surface under test (pages, QuizController, problem
         sources) now lives in the WASM client; the server host is referenced for
         the remaining server-side types (ServerDisk* problem-set source). -->
    <ProjectReference Include="..\BgQuiz_Blazor\BgQuiz_Blazor.csproj" />
    <ProjectReference Include="..\BgQuiz_Blazor.Client\BgQuiz_Blazor.Client.csproj" />
    <!-- The notice component's test reader (NoticeBox): every notice is
         asserted through it, so no test here restates the component's markup.
         Test projects only — it carries bunit, and no product project may
         reference it. Its bunit and AngleSharp versions are the floor for
         this repository's (Directory.Packages.props). -->
    <ProjectReference Include="..\..\BgUiPrimitives_Razor\BgUiPrimitives_Razor.TestSupport\BgUiPrimitives_Razor.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The e2e suite's shared phrase list, compiled in here as well
         (halheinrich/backgammon#4, deliverable 2). LINKED, not referenced: this
         project must not take a dependency on Playwright or on the e2e
         harness, and the e2e project must keep referencing no app assembly.
         Linking one leaf file is what lets CopyDriftTripwireTests hold an
         app-side constant against the literal the browser suite pins, in the
         2-second suite instead of after a publish and a browser run. -->
    <Compile Include="..\BgQuiz_Blazor.E2eTests\ExpectedText.cs" Link="ExpectedText.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
