<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Framework / nullable / implicit-usings / warnings-as-errors are inherited
         from the repo-root Directory.Build.props. Warnings-as-errors is kept (test
         code holds to the same bar); doc-file generation is explicitly opted out —
         a test assembly exports no API to document, and leaving it on would only
         demand XML docs on every public test fixture to satisfy CS1591. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Direct reference: this project compiles against AngleSharp.Dom types
         (rationale in Directory.Packages.props). -->
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="bunit" />
    <PackageReference Include="coverlet.collector" />
    <!-- WebApplicationFactory, for the host-pipeline wire tests. bUnit renders
         components in isolation and cannot see middleware or endpoint routing, so
         it is structurally blind to defects that live in Program.cs. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- The interactive surface under test (pages, QuizController, problem
         sources) now lives in the WASM client; the server host is referenced for
         the remaining server-side types (ServerDisk* problem-set source). -->
    <ProjectReference Include="..\BgQuiz_Blazor\BgQuiz_Blazor.csproj" />
    <ProjectReference Include="..\BgQuiz_Blazor.Client\BgQuiz_Blazor.Client.csproj" />
    <!-- The notice component's test reader (NoticeBox): every notice is
         asserted through it, so no test here restates the component's markup.
         Test projects only — it carries bunit, and no product project may
         reference it. Its bunit and AngleSharp versions are the floor for
         this repository's (Directory.Packages.props). -->
    <ProjectReference Include="..\..\BgUiPrimitives_Razor\BgUiPrimitives_Razor.TestSupport\BgUiPrimitives_Razor.TestSupport.csproj" />
    <!-- The filter surface's storage, stated on a BrowserStoragePlan in the
         surface's own terms (FilterSurfaceStorage: a previous visit's
         selection restored, a panel mount, a commit), so no test here names
         the surface's storage keys or an interop call
         (halheinrich/backgammon#374). Test projects only, like the planner it
         builds on; its bunit and AngleSharp versions are the same floor. -->
    <ProjectReference Include="..\..\XgFilter_Razor\XgFilter_Razor.TestSupport\XgFilter_Razor.TestSupport.csproj" />
    <!-- The record builders (TestRecords): the one way a test builds a
         decision record, owned by the producer that owns the records'
         construction rules, so no fixture here restates them
         (halheinrich/backgammon#273). Test projects only — the assembly
         declares itself unsupported on the browser platform, so a product
         project using it fails the build. -->
    <ProjectReference Include="..\..\BgDataTypes_Lib\BgDataTypes_Lib.TestSupport\BgDataTypes_Lib.TestSupport.csproj" />
    <!-- A FIXTURE PRODUCER, on the e2e project's licence (halheinrich/backgammon#125,
         restated in BgQuiz_Blazor.E2eTests.csproj): the linked SyntheticXgMatch
         below builds a real .xg match in memory from XgFileBuilder / XgFileWriter,
         so the rejected-file tests (halheinrich/backgammon#368) can walk a readable
         file beside a damaged one through the real parse without committing any
         .xg — and without naming TestData, which CI never sees. The client already
         depends on this library, so the graph gains nothing; declared directly
         rather than reached transitively, per the Directory.Packages.props rule.
         Fixture bytes only: no expectation here may come from it. -->
    <ProjectReference Include="..\..\ConvertXgToJson_Lib\ConvertXgToJson_Lib\ConvertXgToJson_Lib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The e2e suite's shared phrase list, compiled in here as well
         (halheinrich/backgammon#4, deliverable 2). LINKED, not referenced: this
         project must not take a dependency on Playwright or on the e2e
         harness, and the e2e project must keep referencing no app assembly.
         Linking one leaf file is what lets CopyDriftTripwireTests hold an
         app-side constant against the literal the browser suite pins, in the
         2-second suite instead of after a publish and a browser run. -->
    <Compile Include="..\BgQuiz_Blazor.E2eTests\ExpectedText.cs" Link="ExpectedText.cs" />
    <!-- The e2e suite's synthesized .xg match, compiled in here as well
         (halheinrich/backgammon#368) — see the ConvertXgToJson_Lib reference
         above for why. One fixture builder, two suites: a damaged file is a
         truncation of these bytes, regenerable, never a committed corrupt file. -->
    <Compile Include="..\BgQuiz_Blazor.E2eTests\SyntheticXgMatch.cs" Link="SyntheticXgMatch.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
