<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Framework / nullable / implicit-usings / warnings-as-errors are inherited
         from the repo-root Directory.Build.props. Warnings-as-errors is kept (test
         code holds to the same bar); doc-file generation is explicitly opted out —
         a test assembly exports no API to document, and leaving it on would only
         demand XML docs on every public test fixture to satisfy CS1591. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Drives a real Chromium against the published artifact. Browsers are a
         one-time local install (see INSTRUCTIONS.md); their absence fails the
         suite loudly — it never skips. -->
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- Deliberately NO ProjectReference to the app: this suite tests the
         published artifact over HTTP in a real browser — the one layer bUnit
         (components in isolation) and the WebApplicationFactory wire tests
         (host pipeline in-process) are both structurally blind to. Every
         expectation here is an independent literal for that same reason.

         The two references below are FIXTURE PRODUCERS, and that is the whole
         of their licence (halheinrich/backgammon#125). A real .xg match file
         carries real players' names and so cannot be committed to a public
         repo; SyntheticXgMatch builds one in memory instead, from
         XgFileBuilder / XgFileWriter in ConvertXgToJson_Lib and the Play /
         Move / DiceRoll / CubeAction vocabulary those take from
         BgDataTypes_Lib. Both are upstream libraries the app already depends
         on, so the dependency graph gains nothing new — and neither may ever
         supply an expectation: no scenario reads a displayed string, a
         selector, or a derived value from them.

         BgDataTypes_Lib is declared even though ConvertXgToJson_Lib would
         supply it transitively, per the rule Directory.Packages.props states
         for AngleSharp: a compile-time dependency arriving only transitively
         is a latent break. -->
    <ProjectReference Include="..\..\BgDataTypes_Lib\BgDataTypes_Lib\BgDataTypes_Lib.csproj" />
    <ProjectReference Include="..\..\ConvertXgToJson_Lib\ConvertXgToJson_Lib\ConvertXgToJson_Lib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Committed copies of two synthetic single-decision .xgp problem files
         (generic player identity — safe for a public repo). Single-decision is
         load-bearing: each quiz is exactly one problem long, so scenarios are
         deterministic without any test-side ordering logic. -->
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
